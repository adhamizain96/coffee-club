generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TagType {
  AMENITY
  VIBE
}

enum CafeStatus {
  OPEN
  TEMPORARILY_CLOSED
  CLOSED
}

enum Region {
  CITY
  NORTH
  NORTHWEST
  WEST
  SOUTH
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Cafe {
  id            String    @id @default(cuid())
  name          String
  /// Stable public URL key (/cafes/[slug]). Required; never changes once published.
  slug          String    @unique
  description   String
  address       String
  neighborhood  String
  latitude      Float
  longitude     Float
  /// Optional: cafes without a photo render a placeholder (src/components/CafeImage.tsx).
  imageUrl      String?   @map("image_url")
  ownerReview   String    @map("owner_review")
  createdAt     DateTime  @default(now()) @map("created_at")
  submitterName String?   @map("submitter_name")
  addedAt       DateTime? @map("added_at")
  /// Null means OPEN (rows created before the column existed). Closed cafes stay listed with a label.
  status        CafeStatus? @default(OPEN)
  /// When the curator last visited. Null for cafes added from research only.
  curatorVisitedAt DateTime? @map("curator_visited_at")
  /// Weekly hours JSON (src/lib/hours.ts). Null means "hours not listed".
  hours          Json?
  /// When the hours were last checked against hoursSourceUrl. Shown to users.
  hoursCheckedAt DateTime? @map("hours_checked_at")
  hoursSourceUrl String?   @map("hours_source_url")
  website        String?
  /// City or suburb area (src/lib/regions.ts). Null until assigned.
  region         Region?

  tags        CafeTag[]
  notes       Note[]
  submissions CafeSubmission[]

  @@map("cafes")
}

model Tag {
  id   String  @id @default(cuid())
  name String  @unique
  type TagType

  cafes CafeTag[]

  @@map("tags")
}

model CafeTag {
  id     String @id @default(cuid())
  cafeId String @map("cafe_id")
  tagId  String @map("tag_id")

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([cafeId, tagId])
  @@map("cafe_tags")
}

model Note {
  id         String   @id @default(cuid())
  cafeId     String   @map("cafe_id")
  content    String   @db.VarChar(500)
  authorName String?  @map("author_name")
  createdAt  DateTime @default(now()) @map("created_at")
  /// Set by an admin to hide the note from every public read.
  hiddenAt   DateTime? @map("hidden_at")

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@map("notes")
}

model CafeSubmission {
  id                String           @id @default(cuid())
  cafeName          String           @map("cafe_name")
  address           String
  normalizedAddress String           @map("normalized_address")
  website           String
  whyYouLikeIt      String?          @map("why_you_like_it") @db.VarChar(280)
  suggestedTagIds   String[]         @map("suggested_tag_ids")
  submitterName     String           @map("submitter_name")
  status            SubmissionStatus @default(PENDING)
  createdAt         DateTime         @default(now()) @map("created_at")
  reviewedAt        DateTime?        @map("reviewed_at")
  rejectionReason   String?          @map("rejection_reason")
  approvedCafeId    String?          @map("approved_cafe_id")

  approvedCafe Cafe? @relation(fields: [approvedCafeId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([normalizedAddress])
  @@map("cafe_submissions")
}
